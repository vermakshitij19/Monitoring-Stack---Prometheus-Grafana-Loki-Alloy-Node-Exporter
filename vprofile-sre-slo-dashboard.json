{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Select your Prometheus data source",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "uid": "vprofile-sre-slo",
  "title": "vProfile - SRE SLO & Reliability",
  "description": "Synthetic SLI dashboard using Blackbox Exporter. Demo objectives: 99.9% availability over 30 days and latency under 500ms. These are not contractual SLAs. 30-day figures are provisional until a full 30 days of samples exist.",
  "tags": [
    "vprofile",
    "sre",
    "slo",
    "blackbox"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "application",
        "type": "constant",
        "label": "Application",
        "query": "vprofile",
        "current": {
          "selected": true,
          "text": "vprofile",
          "value": "vprofile"
        },
        "hide": 2
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Availability SLI \u2014 last 30 days",
      "description": "Percentage of successful synthetic probes. Not per-user request availability. The 30-day value is provisional until a full 30 days of samples have accumulated.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "100 * avg_over_time(probe_success{application=\"$application\"}[30d])",
          "refId": "A",
          "instant": true,
          "legendFormat": "Availability SLI \u2014 last 30 days"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "SLO target",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 3,
        "h": 5
      },
      "targets": [
        {
          "expr": "vector(99.9)",
          "refId": "A",
          "instant": true,
          "legendFormat": "SLO target"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Remaining error budget",
      "description": "Remaining portion of the 0.1% error allowance; can be negative when the SLO is missed.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 9,
        "y": 0,
        "w": 3,
        "h": 5
      },
      "targets": [
        {
          "expr": "100 * (1 - ((1 - avg_over_time(probe_success{application=\"$application\"}[30d])) / 0.001))",
          "refId": "A",
          "instant": true,
          "legendFormat": "Remaining error budget"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Current probe status",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 3,
        "h": 5
      },
      "targets": [
        {
          "expr": "probe_success{application=\"$application\"}",
          "refId": "A",
          "instant": true,
          "legendFormat": "Current probe status"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "30-day sample count",
      "description": "A complete 30-day window at a 30-second interval is about 86,400 samples.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 3,
        "h": 5
      },
      "targets": [
        {
          "expr": "count_over_time(probe_success{application=\"$application\"}[30d])",
          "refId": "A",
          "instant": true,
          "legendFormat": "30-day sample count"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center"
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Probe latency",
      "description": "Synthetic end-to-end probe duration in seconds.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "probe_duration_seconds{application=\"$application\"}",
          "refId": "A",
          "instant": false,
          "legendFormat": "Probe latency"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "HTTP status code",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "probe_http_status_code{application=\"$application\"}",
          "refId": "A",
          "instant": false,
          "legendFormat": "HTTP status code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Latency SLI \u2014 under 500 ms",
      "description": "Percentage of probe samples below 500 ms over the available 30-day window.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "100 * avg_over_time((probe_duration_seconds{application=\"$application\"} < bool 0.5)[30d:30s])",
          "refId": "A",
          "instant": true,
          "legendFormat": "Latency SLI \u2014 under 500 ms"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center"
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Error budget burn rate",
      "description": "1x means failures consume the error budget at the sustainable rate. Above 1x burns budget faster.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 6,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "(1 - avg_over_time(probe_success{application=\"$application\"}[1h])) / 0.001",
          "refId": "A",
          "instant": false,
          "legendFormat": "Error budget burn rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "SSL certificate days remaining",
      "description": "Days until earliest certificate expiry, if the metric is exposed by the probe.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "(probe_ssl_earliest_cert_expiry{application=\"$application\"} - time()) / 86400",
          "refId": "A",
          "instant": true,
          "legendFormat": "SSL certificate days remaining"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "d"
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center"
      }
    }
  ]
}